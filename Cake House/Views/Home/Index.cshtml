@model List<Cake_House.Models.Cake>
<div class="text-center" style="background:#fff8e1;padding:20px;border-radius:15px;">
    <h1 class="display-4 fw-bold">Welcome to Cake House</h1>
    <a asp-controller="Cakes" asp-action="Index" class="btn btn-warning btn-lg rounded-pill mt-2">See All Cakes</a>
</div>

<h3 class="text-center mt-4">Our Featured Cakes</h3>
<div class="row mt-3">
@foreach(var cake in Model)
{
    <div class="col-md-4 mb-3">
        <div class="card shadow">
            <img src="@cake.ImagePath" class="card-img-top" style="height:200px;object-fit:cover;">
            <div class="card-body text-center">
                <h5>@cake.Name</h5>
                <p>Tk @cake.Price</p>
            </div>
        </div>
    </div>
}
</div>