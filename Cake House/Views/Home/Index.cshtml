@{
    ViewData["Title"] = "Cake House - Fresh Cakes";
}
<div style="background-color: #fff8f0;">
    <div class="text-center py-5" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=1200'); background-size: cover; color: white;">
        <h1 style="font-size: 3.5rem; font-weight: bold;">Welcome to Cake House</h1>
        <p class="lead mt-3">Fresh, Delicious & Made With Love</p>
        <a href="/Cakes" class="btn btn-warning btn-lg mt-3 px-5" style="border-radius:30px; font-weight:bold;">See All Cakes</a>
    </div>

    <div class="container py-5">
        <h2 class="text-center mb-5" style="font-weight:bold; color:#d2691e;">Our Special Cakes</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius:15px; overflow:hidden;">
                    <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500" style="height:220px; object-fit:cover;" class="card-img-top">
                    <div class="card-body text-center">
                        <h5>Chocolate Cake</h5>
                        <p class="text-muted">Rich chocolate with creamy frosting</p>
                        <h5 style="color:#d2691e;">৳ 1200</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius:15px; overflow:hidden;">
                    <img src="https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=500" style="height:220px; object-fit:cover;" class="card-img-top">
                    <div class="card-body text-center">
                        <h5>Vanilla Cake</h5>
                        <p class="text-muted">Classic vanilla with fresh cream</p>
                        <h5 style="color:#d2691e;">৳ 1000</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius:15px; overflow:hidden;">
                    <img src="https://images.unsplash.com/photo-1621303837174-89787a7d4729?w=500" style="height:220px; object-fit:cover;" class="card-img-top">
                    <div class="card-body text-center">
                        <h5>Red Velvet</h5>
                        <p class="text-muted">Soft red velvet with cheese frosting</p>
                        <h5 style="color:#d2691e;">৳ 1500</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>